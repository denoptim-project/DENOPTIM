#
# This is the parameter file for test t35-5 (multiple matches of child side + symmetry)
#
TESTGENOPS-OP=MUTATION
TESTGENOPS-inpFile=graph-5.sdf
TESTGENOPS-outFile=graph_mut-5.sdf
# WARNING: Reinvent can only create linkers between two warheads!
TESTGENOPS-MutationTarget=5
TESTGENOPS-ApIdOnTargetVertex=0
TESTGENOPS-MutationType=ADDLINK
# Use this to generate a precomputed response file, although to ensure
# reproducibility you want to edit such file to make it contain
# repetitions of the same item instead of N different items.
#TESTGENOPS-RECORDREINVENTANSWERSTOFILE=reinvent_answer.json
TESTGENOPS-PrecomputedReinventAnswerFile=reinvent_answer-5.json

# Interface with Reinvent
GA-UseReinventForLinkers=true
# This is not really used because of the pre-computed answer, but needs to be here
GA-ReinventLinkersConfigFile=dummy_reinvent_config.json
GA-ReinventServerHostname=localhost
GA-ReinventServerPort=9999

