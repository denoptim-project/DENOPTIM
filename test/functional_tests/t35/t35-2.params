#
# This is the parameter file for test t35-2
#
TESTGENOPS-OP=MUTATION
TESTGENOPS-inpFile=graph-2.sdf
TESTGENOPS-outFile=graph_mut-2.sdf
TESTGENOPS-MutationTarget=6
TESTGENOPS-MutationType=CHANGEBRANCH
# Use this to generate a precomputed response file, although to ensure
# reproducibility you want to edit such file to make it contain
# repetitions of the same item instead of N different items.
#TESTGENOPS-RECORDREINVENTANSWERSTOFILE=reinvent_answer.json
TESTGENOPS-PrecomputedReinventAnswerFile=reinvent_answer-2.json

# Interface with Reinvent
GA-UseReinventForGrowth=true
GA-ReinventGrowthConfigFile=dummy_reinvent_config.json
GA-ReinventServerHostname=localhost
GA-ReinventServerPort=9999

